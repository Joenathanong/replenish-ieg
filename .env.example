# ---- Koneksi OCS ----
OCS_BASE_URL=https://ocs.iegsystem.id
OCS_USERNAME=ADMIN
OCS_PASSWORD=ADMIN
OCS_COMPANY_DB=EJI_WMS

# ---- Database TiDB Cloud ----
# Cara termudah: salin "Connection String" dari TiDB Cloud (pilih format General/Node.js)
# PENTING: ganti nama database di ujung URL menjadi ocs_replenish.
# String bawaan dari TiDB Cloud biasanya menunjuk ke `test` atau `sys` (database sistem).
TIDB_URL=mysql://USER.root:PASSWORD@gateway01.ap-southeast-1.prod.aws.tidbcloud.com:4000/ocs_replenish

# Atau isi terpisah bila lebih nyaman (TIDB_URL akan menang bila keduanya ada):
# TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
# TIDB_PORT=4000
# TIDB_USER=xxxxxxxx.root
# TIDB_PASSWORD=
# TIDB_DATABASE=ocs_replenish

# Jumlah koneksi dalam pool. Kecil saja untuk serverless.
DB_POOL_SIZE=5

# ---- Keamanan cron ----
# Wajib diisi di Vercel. Vercel mengirimkannya sebagai "Authorization: Bearer <CRON_SECRET>".
# Buat nilai acak, misalnya: node -e "console.log(crypto.randomUUID())"
CRON_SECRET=

# ---- Server lokal (tidak dipakai di Vercel) ----
PORT=3000
HOST=0.0.0.0

# Lama riwayat snapshot disimpan
HISTORY_RETENTION_DAYS=30

# Berkas SQLite lama; hanya dibaca oleh `npm run import-sqlite`
DB_PATH=./data/replenish.db
