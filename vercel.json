{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/((?!api/|css/|js/).*)", "destination": "/index.html" }
  ]
}
